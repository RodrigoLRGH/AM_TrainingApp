generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSTRUCTOR
  CLIENTE
}

model User {
  id   String @id @default(uuid())
  role Role
  name String

  // Solo para instructores
  email    String? @unique
  password String?

  // Solo para clientes
  clientCode String? @unique
  active     Boolean @default(true)

  // Relación instructor -> clientes
  instructorId String?
  instructor   User?   @relation("InstructorClients", fields: [instructorId], references: [id])
  clients      User[]  @relation("InstructorClients")

  // Rutinas
  routinesAsInstructor Routine[] @relation("InstructorRoutines")
  routinesAsClient     Routine[] @relation("ClientRoutines")

  // Configuración de asistencia 
  gymLatitude     Float?
  gymLongitude    Float?
  gymRadiusMeters Int?
  gymQrCode       String? @unique

  attendancesAsInstructor Attendance[] @relation("InstructorAttendance")
  attendancesAsClient     Attendance[] @relation("ClientAttendance")

  // Running
  runSessions RunSession[]

  measurements   Measurement[]
  sessionRatings SessionRating[]
  pushToken      String?
  announcements  Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
}

model Measurement {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  weightKg Float?
  chestCm  Float?
  waistCm  Float?
  hipsCm   Float?
  armCm    Float?
  legCm    Float?

  recordedAt DateTime @default(now())

  @@index([clientId])
}

model SessionRating {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  routineId String?
  effort    Int
  note      String?

  createdAt DateTime @default(now())

  @@index([clientId])
}


model Announcement {
  id      String @id @default(uuid())
  title   String
  message String

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id])

  createdAt DateTime @default(now())

  @@index([instructorId])
}

enum AttendanceMethod {
  GEO
  QR
}

model Attendance {
  id     String           @id @default(uuid())
  method AttendanceMethod
  date   DateTime         @default(now())

  clientId String
  client   User   @relation("ClientAttendance", fields: [clientId], references: [id])

  instructorId String
  instructor   User   @relation("InstructorAttendance", fields: [instructorId], references: [id])

  createdAt DateTime @default(now())

  @@index([instructorId])
  @@index([clientId])
}

model Routine {
  id         String    @id @default(uuid())
  title      String
  date       DateTime?
  isTemplate Boolean   @default(false)

  instructorId String
  instructor   User   @relation("InstructorRoutines", fields: [instructorId], references: [id])

  clientId String?
  client   User?   @relation("ClientRoutines", fields: [clientId], references: [id])

  exercises Exercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([clientId])
}

model Exercise {
  id        String  @id @default(uuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  name  String
  sets  Int
  reps  Int
  order Int    @default(0)
}

model RunSession {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  distanceMeters  Float?
  durationSeconds Int?

  points RunPoint[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

model RunPoint {
  id           String     @id @default(uuid())
  runSessionId String
  runSession   RunSession @relation(fields: [runSessionId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  order     Int
  timestamp DateTime

  @@index([runSessionId])
}
